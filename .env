# =============================================================================
# ADAPTIVE STRATEGY & SCHEDULING (Production)
# =============================================================================

# NEW: Optimized Production Timing Configuration
ADAPTIVE_STRATEGY_ENABLED=true               # Enable adaptive strategy updates
ADAPTIVE_STRATEGY_OFFSET_MINUTES=-5          # Run 5 min before hour (XX:55)

# Data Fetch Timing (1 min after hour for fresh data)
OHLCV_FETCH_DELAY_SECONDS=60                # Wait 60s after hour for fresh API data
SOCIAL_FETCH_DELAY_SECONDS=60               # Wait 60s after hour for fresh API data

# Data Range Strategy (API freshness + Database historical)
OHLCV_LOOKBACK_HOURS=48                     # API fetch: Last 48 hours (freshness)
OHLCV_INFERENCE_LOOKBACK_HOURS=360          # Total needed: 360 hours (15 days)
SOCIAL_LOOKBACK_DAYS=3                      # API fetch: Last 3 days (freshness)  
SOCIAL_INFERENCE_LOOKBACK_DAYS=7            # Total needed: 7 days

# API Rate Limiting (actual limits from providers)
BIRDEYE_RATE_LIMIT_RPM=1500                 # BirdEye: 1500 requests per minute (25 req/sec)
LUNARCRUSH_RATE_LIMIT_RPM=10                # LunarCrush: 10 requests per minute (6 sec between calls)

# Optimized Fetch Parameters
OHLCV_MAX_WORKERS=5                         # Higher parallelism for 1500 RPM
OHLCV_DELAY_SECONDS=0.1                     # Minimal delay (25 req/sec capacity)
OHLCV_BATCH_SIZE=2000                       # Larger batches for efficiency
SOCIAL_BATCH_SIZE=25                        # Smaller batches for 10 RPM limit
SOCIAL_TIMEOUT_MINUTES=20                   # Longer timeout for rate-limited social data

# Portfolio Strategy Configuration
PORTFOLIO_ALLOCATION_METHOD=signal_strength  # Use signal strength weighting (matches AllocationMethod enum)

# =============================================================================
# ADAPTIVE STRATEGY ENGINE CONFIGURATION
# =============================================================================

# Adaptation settings
ADAPTATION_METHOD=hybrid                         # volatility_based, performance_based, momentum_based, regime_switching, hybrid
ADAPTATION_FREQUENCY_MINUTES=60                 # How often to adapt parameters (minutes)
MIN_SIGNALS_FOR_ADAPTATION=10                  # Minimum signals before adapting

# Performance thresholds for adaptation
MIN_WIN_RATE_THRESHOLD=0.45                    # Below this, increase thresholds
TARGET_WIN_RATE=0.55                           # Target win rate for optimization
MAX_WIN_RATE_THRESHOLD=0.70                    # Above this, decrease thresholds

# Volatility-based adaptation
LOW_VOLATILITY_THRESHOLD=0.02                  # 2% daily volatility threshold
HIGH_VOLATILITY_THRESHOLD=0.06                 # 6% daily volatility threshold
VOLATILITY_ADAPTATION_FACTOR=0.5               # Adaptation strength for volatility

# A/B testing configuration
ENABLE_AB_TESTING=true                          # Enable A/B testing framework
AB_TEST_ALLOCATION=0.1                          # 10% of signals for testing
AB_TEST_DURATION_DAYS=7                         # A/B test duration in days

# Performance monitoring
PERFORMANCE_LOOKBACK_DAYS=30                    # Days of history for performance analysis
ADAPTATION_SMOOTHING_FACTOR=0.3                # EMA smoothing for parameter changes 
# DATABASE CONFIGURATION (DEVELOPMENT)
# =============================================================================

# PostgreSQL + TimescaleDB (Development)
DB_HOST=localhost
DB_PORT=6432
DB_NAME=calvin_trading_dev
DB_USER=calvin_dev
DB_PASSWORD=calvin_dev_password

# =============================================================================
# PRODUCTION-SPECIFIC CONFIGURATION
# =============================================================================
# These variables are needed for production Docker deployment
# Copy these to your production .env file and update with real values

# Production Database URLs (for docker-compose.production.yml)
# DATABASE_URL=postgresql://calvin:your_production_password@timescaledb:5432/calvin_db
# POSTGRES_PASSWORD=your_secure_production_password

# Production Redis (no password in our setup)
# REDIS_URL=redis://redis:6379/0

# Calvin Trading Authority (CRITICAL - Keep extremely secure)
# CALVIN_AUTHORITY_PRIVATE_KEY=your_calvin_trading_private_key_here

# Deployed Smart Contract Program IDs
# CALVIN_VAULT_PROGRAM_ID=your_deployed_vault_program_id
# CALVIN_STAKING_PROGRAM_ID=your_deployed_staking_program_id

# Production Data Intervals
# OHLCV_INTERVAL_MINUTES=60
# SOCIAL_INTERVAL_MINUTES=60

# Production Trading Parameters
# MAX_SLIPPAGE_BPS=100
# MAX_TRADE_SIZE_USDC=10000
# MIN_TRADE_SIZE_USDC=100

# Emergency Stop Loss (Production)
# PORTFOLIO_STOP_LOSS_PCT=-15.0
# INDIVIDUAL_STOP_LOSS_PCT=-25.0
# MAX_DAILY_EMERGENCY_EXITS=5

# Production Environment
# CALVIN_ENV=production
# LOG_LEVEL=INFO

# ================================
# PRODUCTION DEPLOYMENT & TIMING
# ================================

# NEW: Optimized Production Timing Configuration
ADAPTIVE_STRATEGY_ENABLED=true               # Enable adaptive strategy updates
ADAPTIVE_STRATEGY_OFFSET_MINUTES=-5          # Run 5 min before hour (XX:55)

# Data Fetch Timing (1 min after hour for fresh data)
OHLCV_FETCH_DELAY_SECONDS=60                # Wait 60s after hour for fresh API data
SOCIAL_FETCH_DELAY_SECONDS=60               # Wait 60s after hour for fresh API data

# Data Range Strategy (API freshness + Database historical)
OHLCV_LOOKBACK_HOURS=48                     # API fetch: Last 48 hours (freshness)
OHLCV_INFERENCE_LOOKBACK_HOURS=360          # Total needed: 360 hours (15 days)
SOCIAL_LOOKBACK_DAYS=3                      # API fetch: Last 3 days (freshness)  
SOCIAL_INFERENCE_LOOKBACK_DAYS=7            # Total needed: 7 days

# API Rate Limiting (actual limits from providers)
BIRDEYE_RATE_LIMIT_RPM=1500                 # BirdEye: 1500 requests per minute (25 req/sec)
LUNARCRUSH_RATE_LIMIT_RPM=10                # LunarCrush: 10 requests per minute (6 sec between calls)

# Optimized Fetch Parameters
OHLCV_MAX_WORKERS=5                         # Higher parallelism for 1500 RPM
OHLCV_DELAY_SECONDS=0.1                     # Minimal delay (25 req/sec capacity)
OHLCV_BATCH_SIZE=2000                       # Larger batches for efficiency
SOCIAL_BATCH_SIZE=25                        # Smaller batches for 10 RPM limit
SOCIAL_TIMEOUT_MINUTES=20                   # Longer timeout for rate-limited social data

# Production Resource Limits
MEMORY_LIMIT=8GB                            # Production memory allocation
CPU_LIMIT=4.0                               # Production CPU cores
MEMORY_RESERVATION=4GB                      # Guaranteed memory
CPU_RESERVATION=2.0                         # Guaranteed CPU 
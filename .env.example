# PgBouncer (Development)
PGBOUNCER_HOST=localhost
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_SIZE=25
PGBOUNCER_MAX_CLIENT_CONN=100

# =============================================================================
# REDIS CACHING CONFIGURATION (DEVELOPMENT)
# =============================================================================

# Cache TTL Settings
DATA_PROCESSOR_CACHE_TTL=3600              # 1 hour (aligns with inference schedule)
BATCH_INFERENCE_CACHE_TTL=3600             # 1 hour
FEATURE_CACHE_MAX_SIZE_MB=100              # 100MB Redis cache limit

# Cache Key Prefixes
REDIS_INFERENCE_KEY_PREFIX=inference_features
REDIS_BATCH_KEY_PREFIX=batch_inference

# Redis Configuration for Caching
REDIS_INFERENCE_DB=0                       # Use default DB (already configured)
REDIS_PIPELINE_SIZE=100                    # Batch Redis operations

# Cache Performance Settings
ENABLE_REDIS_CACHE=true                    # Enable Redis caching (can be disabled for rollback)
CACHE_HIT_RATE_TARGET=70                   # Target cache hit rate percentage
CACHE_MONITORING_ENABLED=true             # Enable cache performance monitoring


# =============================================================================
# CALVIN AI PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG_MODE=false

# =============================================================================
# API KEYS & EXTERNAL SERVICES
# =============================================================================

# BirdEye API Keys (Production)
BIRDEYE_API_KEY_1=production_birdeye_key_1
BIRDEYE_API_KEY_2=production_birdeye_key_2
BIRDEYE_API_KEY_3=production_birdeye_key_3
BIRDEYE_API_KEY_4=production_birdeye_key_4
BIRDEYE_API_KEY_5=production_birdeye_key_5
BIRDEYE_CHAIN=solana

# CoinAPI Key
COINAPI_KEY=production_coinapi_key_here

# Helius RPC (Production - Replace with your actual key)
HELIUS_API_KEY=your_production_helius_api_key_here
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}

# LunarCrush API (Production - Replace with your actual key)
LUNARCRUSH_API_KEY=your_production_lunarcrush_api_key_here

# =============================================================================
# DATABASE CONFIGURATION (PRODUCTION)
# =============================================================================

# PostgreSQL + TimescaleDB (Production)
DB_HOST=localhost
DB_PORT=6432
DB_NAME=calvin_trading
DB_USER=calvin_prod
DB_PASSWORD=super_secure_prod_password_456789
DB_SSL_MODE=require

# Database URLs
DATABASE_URL=postgresql://calvin_prod:super_secure_prod_password_456789@localhost:6432/calvin_trading
DATABASE_URL_ASYNC=postgresql+asyncpg://calvin_prod:super_secure_prod_password_456789@localhost:6432/calvin_trading

# Redis Configuration (Production)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=super_secure_redis_password_789012
REDIS_DB=0
REDIS_URL=redis://:super_secure_redis_password_789012@localhost:6379/0

# PgBouncer (Production)
PGBOUNCER_HOST=localhost
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_SIZE=50
PGBOUNCER_MAX_CLIENT_CONN=200

# Replication (Production)
REPLICATION_PASSWORD=replication_password_345678

# =============================================================================
# REDIS CACHING CONFIGURATION (PRODUCTION)
# =============================================================================

# Cache TTL Settings
DATA_PROCESSOR_CACHE_TTL=3600              # 1 hour (aligns with inference schedule)
BATCH_INFERENCE_CACHE_TTL=3600             # 1 hour
FEATURE_CACHE_MAX_SIZE_MB=500              # 500MB Redis cache limit for production

# Cache Key Prefixes
REDIS_INFERENCE_KEY_PREFIX=inference_features
REDIS_BATCH_KEY_PREFIX=batch_inference

# Redis Configuration for Caching
REDIS_INFERENCE_DB=0                       # Use default DB (already configured)
REDIS_PIPELINE_SIZE=200                    # Larger batches for production

# Cache Performance Settings
ENABLE_REDIS_CACHE=true                    # Enable Redis caching
CACHE_HIT_RATE_TARGET=80                   # Higher target for production
CACHE_MONITORING_ENABLED=true             # Enable cache performance monitoring

# =============================================================================
# SOLANA & BLOCKCHAIN CONFIGURATION
# =============================================================================

# Solana RPC Settings (Production)
SOLANA_RPC_URL=${HELIUS_RPC_URL}
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
SOLANA_COMMITMENT=confirmed
SOLANA_NETWORK=mainnet-beta

# Calvin Wallet (Production - KEEP SECURE!)
CALVIN_WALLET_PRIVATE_KEY=your_production_calvin_wallet_private_key_here
CALVIN_WALLET_PUBLIC_KEY=your_production_calvin_wallet_public_key_here

# Smart Contract Addresses (Production)
CALVIN_TOKEN_ADDRESS=229vWzBTiUNdraYpVtSH9usTwwVxcyPDbBWf1zEPpump
STAKING_PROGRAM_ID=your_production_staking_program_id_here
VAULT_PROGRAM_ID=your_production_vault_program_id_here
USDC_TOKEN_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Treasury & Fee Configuration (Production)
TREASURY_WALLET=your_production_treasury_wallet_address_here
PERFORMANCE_FEE_RATE=0.075                 # 7.5%
DEPOSIT_FEE_RATE=0.025                     # 2.5%
WITHDRAWAL_FEE_RATE=0.0                    # 0%

# =============================================================================
# TRADING CONFIGURATION (PRODUCTION)
# =============================================================================

# DEX Integration (Production)
JUPITER_API_URL=https://quote-api.jup.ag/v6
ORCA_API_URL=https://api.orca.so/v1
DEFAULT_SLIPPAGE_BPS=50                    # 0.5%
MAX_SLIPPAGE_BPS=100                       # 1.0%
PRIORITY_FEE_MICROLAMPORTS=5000

# Trading Limits & Risk Management (Production)
MAX_POSITION_SIZE_PERCENT=20.0             # Max 20% of vault per token
MAX_CONCURRENT_POSITIONS=5
MIN_TRADE_SIZE_USDC=10.0
MAX_TRADE_SIZE_USDC=100000.0

# Stop Loss & Take Profit (Production)
DEFAULT_STOP_LOSS_PERCENT=5.0              # 5% stop loss
DEFAULT_TAKE_PROFIT_PERCENT=15.0           # 15% take profit
TRAILING_STOP_PERCENT=2.0                  # 2% trailing stop

# =============================================================================
# MODEL CONFIGURATION (PRODUCTION)
# =============================================================================

# Model Paths
MODEL_BASE_PATH=./calvin_1/models
FASTDQN_MODEL_PATH=${MODEL_BASE_PATH}/vault_ensemble
MODEL_REGISTRY_PATH=${MODEL_BASE_PATH}/registry

# FastDQN Ensemble Settings (Production)
FASTDQN_MEMORY_SIZE=10000
FASTDQN_BATCH_SIZE=256
FASTDQN_LEARNING_RATE=0.001
FASTDQN_EPSILON_DECAY=0.995
FASTDQN_MIN_EPSILON=0.01

# Prediction Settings (Production)
MIN_PREDICTION_CONFIDENCE=0.70             # 70% minimum confidence
ENSEMBLE_CONSENSUS_THRESHOLD=0.80          # 80% agreement required
MODEL_UPDATE_INTERVAL_HOURS=24             # Retrain every 24 hours

# GPU Configuration (Production)
USE_GPU=true
GPU_MEMORY_LIMIT_MB=4096
MIXED_PRECISION=true

# =============================================================================
# DATA PROCESSING CONFIGURATION (PRODUCTION)
# =============================================================================

# Data Processor Settings (Production)
DATA_PROCESSOR_CHUNK_SIZE=1000             # Rows per processing chunk
DATA_PROCESSOR_MAX_WORKERS=4               # Parallel processing workers

# WebSocket Configuration (Production)
WS_MAX_TOKENS_PER_CONNECTION=100
WS_RECONNECT_DELAY=2.0
WS_MAX_RECONNECT_DELAY=60.0
WS_MAX_RECONNECT_ATTEMPTS=10
WS_HEARTBEAT_INTERVAL=30.0
WS_CONNECTION_TIMEOUT=10.0
WS_MESSAGE_QUEUE_SIZE=1000

# Tokens to Track (Production)
TRACKED_TOKENS=So11111111111111111111111111111111111111112,EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v,DezXAZ8z7PnrnRJjz3wXBoRgixCa6xjnB7YaB1pPB263,JUPyiwrYJFskUPiHa7hkeR8VUtAeFoSYbKedZNsDvCN
DEFAULT_CHART_TYPE=1H

# Technical Indicators Configuration (Production)
TECHNICAL_INDICATORS_ENABLED=true
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
BOLLINGER_PERIOD=20
BOLLINGER_STD=2
SMA_PERIODS=5,10,20,50,200
EMA_PERIODS=12,26,50,100

# Feature Engineering Settings (Production)
ENABLE_CYCLICAL_TIME_FEATURES=true
ENABLE_VOLATILITY_FEATURES=true
ENABLE_FAIR_VALUE_GAPS=true
ENABLE_MONEY_FLOW_FEATURES=true
ENABLE_MULTI_TIMEFRAME=true
MULTI_TIMEFRAME_PERIODS=1h,4h,1d

# Data Quality Settings (Production)
MIN_DATA_POINTS_FOR_INFERENCE=24
DATA_QUALITY_THRESHOLD=0.95
OUTLIER_DETECTION_ENABLED=true
OUTLIER_Z_SCORE_THRESHOLD=3.0

# =============================================================================
# VAULT SYSTEM CONFIGURATION (PRODUCTION)
# =============================================================================

# Tier System (Production)
TIER_1_REQUIREMENT=10000000               # 10M CALVIN tokens
TIER_2_REQUIREMENT=2000000                # 2M CALVIN tokens  
TIER_3_REQUIREMENT=500000                 # 500K CALVIN tokens
TIER_4_REQUIREMENT=0                      # Whitelisted users

# Vault Limits per Tier (Production)
TIER_1_MAX_DEPOSIT=1000000                # $1M USDC
TIER_2_MAX_DEPOSIT=250000                 # $250K USDC
TIER_3_MAX_DEPOSIT=50000                  # $50K USDC
TIER_4_MAX_DEPOSIT=10000                  # $10K USDC

# Vault Operational Settings (Production)
MIN_VAULT_BALANCE=1000                    # $1K minimum vault balance
EMERGENCY_STOP_ENABLED=true
AUTO_COMPOUND_ENABLED=true
REBALANCE_INTERVAL_HOURS=6

# =============================================================================
# PERFORMANCE & MONITORING (PRODUCTION)
# =============================================================================

# Performance Targets (Production)
TARGET_PREDICTION_LATENCY_MS=100
TARGET_TRADE_EXECUTION_MS=2000
TARGET_DB_QUERY_MS=10
TARGET_UPTIME_PERCENT=99.9

# Monitoring & Alerting (Production)
ENABLE_METRICS=true
METRICS_PORT=8080
HEALTH_CHECK_INTERVAL=30
ALERT_EMAIL=admin@calvin.ai
SLACK_WEBHOOK_URL=your_production_slack_webhook_url_here

# Grafana Configuration
GRAFANA_PASSWORD=grafana_admin_password_901234
PGBOUNCER_ADMIN_USER=admin
PGBOUNCER_STATS_USER=stats

# Logging Configuration (Production)
LOG_FILE_PATH=./logs/calvin.log
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=5
LOG_TO_FILE=true
LOG_TO_CONSOLE=false

# =============================================================================
# RATE LIMITING & QUOTAS (PRODUCTION)
# =============================================================================

# API Rate Limits (Production)
BIRDEYE_RATE_LIMIT_PER_MINUTE=600
HELIUS_RATE_LIMIT_PER_MINUTE=1000
JUPITER_RATE_LIMIT_PER_MINUTE=240

# Internal Rate Limits (Production)
MAX_PREDICTIONS_PER_SECOND=10
MAX_TRADES_PER_MINUTE=30
MAX_DB_QUERIES_PER_SECOND=100

# =============================================================================
# BACKUP & RECOVERY (PRODUCTION)
# =============================================================================

# Database Backup (Production)
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=./backups

# Model Backup (Production)
MODEL_BACKUP_ENABLED=true
MODEL_BACKUP_INTERVAL_HOURS=24
MODEL_BACKUP_RETENTION_DAYS=7

# =============================================================================
# SECURITY SETTINGS (PRODUCTION)
# =============================================================================

# Encryption (Production)
ENCRYPT_SENSITIVE_DATA=true
ENCRYPTION_KEY=your_32_character_production_encryption_key

# Access Control (Production)
REQUIRE_API_KEY=true
API_KEY_HEADER=X-Calvin-API-Key
ADMIN_API_KEY=your_production_admin_api_key_here

# Network Security (Production)
ALLOWED_IPS=your_production_server_ip,your_monitoring_ip
ENABLE_CORS=false
MAX_REQUEST_SIZE_MB=10

# =============================================================================
# FEATURE FLAGS (PRODUCTION)
# =============================================================================

# Trading Features (Production)
ENABLE_LIVE_TRADING=true
ENABLE_STOP_LOSS=true
ENABLE_TAKE_PROFIT=true
ENABLE_TRAILING_STOPS=true

# Model Features (Production)
ENABLE_ENSEMBLE_TRADING=true
ENABLE_CONFIDENCE_FILTERING=true
ENABLE_CORRELATION_FILTERING=true
ENABLE_AUTO_RETRAINING=true

# Monitoring Features (Production)
ENABLE_REAL_TIME_ALERTS=true
ENABLE_PERFORMANCE_TRACKING=true
ENABLE_RISK_MONITORING=true

# =============================================================================
# DOCKER & DEPLOYMENT (PRODUCTION)
# =============================================================================

# Docker Configuration (Production)
DOCKER_NETWORK=calvin-network
TIMESCALEDB_CONTAINER=calvin-timescaledb
REDIS_CONTAINER=calvin-redis
PGBOUNCER_CONTAINER=calvin-pgbouncer

# Resource Limits (Production)
MEMORY_LIMIT=4GB
CPU_LIMIT=2
WORKER_PROCESSES=4


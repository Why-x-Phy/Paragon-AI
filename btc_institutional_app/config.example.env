APP_ENV=production
EXECUTION_ENABLED=false
POSTGRES_DB=btc_app
POSTGRES_USER=btc_user
POSTGRES_PASSWORD=btc_pass_change_me
DATABASE_URL=postgresql://btc_user:btc_pass_change_me@postgres:5432/btc_app
GATE_MIN_SAMPLE=30
GATE_MIN_PROFIT_FACTOR=1.2
GATE_MAX_DRAWDOWN_PCT=6.0
GATE_MIN_WINRATE=0.45

# Optional Pionex (Phase 2, gated)
PIONEX_BASE_URL=https://api.pionex.com
PIONEX_API_KEY=
PIONEX_API_SECRET=
PIONEX_RECV_WINDOW_MS=5000

COINGLASS_API_KEY=
EVENT_CALENDAR_URL=

# Comma-separated JSON calendar endpoints accepted by the event connector.
# Example payloads: {"events": [...]} or {"data": [...]} or [ ... ]

# Optional *_FILE indirection for secrets (recommended in production)
# PIONEX_API_KEY_FILE=/run/secrets/pionex_api_key
# PIONEX_API_SECRET_FILE=/run/secrets/pionex_api_secret
# EVENT_CALENDAR_URL_FILE=/run/secrets/event_calendar_url

# TLS assets for nginx TLS profile
TLS_CERT_PATH=./nginx/certs/fullchain.pem
TLS_KEY_PATH=./nginx/certs/privkey.pem
EVENT_CALENDAR_CURRENCY=USD
EVENT_CALENDAR_KEYWORDS=CPI,FOMC,NFP,Non-Farm Payroll,Interest Rate

# Optional backend write-protection token for mutating API endpoints
API_WRITE_TOKEN=
# API_WRITE_TOKEN_FILE=/run/secrets/api_write_token

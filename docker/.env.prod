# Calvin AI Production Environment Variables Template
# Copy this to .env.prod and fill in real values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL/TimescaleDB Production Settings
DB_PASSWORD_PROD=AppCherry1926
POSTGRES_USER=calvin_prod
POSTGRES_DB=calvin_trading

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis Production Settings
REDIS_PASSWORD_PROD=AppCherry1926

# =============================================================================
# MONITORING CONFIGURATION (Optional)
# =============================================================================

# Grafana Settings (if using monitoring profile)
GRAFANA_PASSWORD=AppCherry1926
GRAFANA_USER=admin

# =============================================================================
# USAGE INSTRUCTIONS
# =============================================================================

# 1. Copy this file:
#    cp docker/.env.prod.template docker/.env.prod
#
# 2. Edit .env.prod with your actual passwords
#
# 3. Start production stack:
#    cd docker && docker-compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# 4. Optional: Start with monitoring:
#    cd docker && docker-compose -f docker-compose.prod.yml --env-file .env.prod --profile monitoring up -d
#
# 5. Connect Calvin AI backend to production database:
#    Set DATABASE_URL=postgresql://calvin_prod:your_password@your_server:5433/calvin_trading
#    Set REDIS_URL=redis://:your_redis_password@your_server:6379/0

# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================

# Security:
# ✓ Generate strong passwords (32+ characters)
# ✓ Use different passwords than development
# ✓ Consider using Docker secrets instead of environment variables
# ✓ Enable firewall rules for production ports
# ✓ Set up SSL certificates for PostgreSQL if needed

# Monitoring:
# ✓ Enable monitoring profile in production
# ✓ Set up log rotation
# ✓ Configure backup strategy
# ✓ Set up alerting for critical metrics

# Performance:
# ✓ Ensure adequate server resources (4GB+ RAM for database)
# ✓ Use SSD storage for best performance
# ✓ Monitor disk space for time-series data growth
# ✓ Test connection pooling under load 
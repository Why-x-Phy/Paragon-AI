# UPDATE: generate_portfolio_signals method
async def generate_portfolio_signals(self, cycle_timestamp: Optional[datetime] = None) -> PortfolioSignal:
    """Generate portfolio signals with cycle tracking metadata"""
    try:
        # Set cycle timestamp if not provided
        if cycle_timestamp is None:
            cycle_timestamp = datetime.now().replace(minute=0, second=0, microsecond=0)
        
        # Existing signal generation logic...
        signals = await self._generate_signals_for_all_tokens()
        
        # NEW: Enhanced portfolio risk assessment
        risk_metrics = await self._calculate_enhanced_risk_metrics()
        
        # NEW: Calculate portfolio-level metrics for cycle tracking
        portfolio_value = await self._get_current_portfolio_value()
        total_exposure = sum(s.position_value_usdc for s in signals.buy_signals)
        exposure_pct = (total_exposure / portfolio_value * 100) if portfolio_value > 0 else 0
        
        # Calculate diversification score
        diversification_score = self._calculate_diversification_score(signals.buy_signals)
        
        # Enhanced portfolio signal with cycle metadata
        portfolio_signal = PortfolioSignal(
            buy_signals=signals.buy_signals,
            sell_signals=signals.sell_signals,
            portfolio_risk_score=risk_metrics['overall_risk'],
            execution_priority=self._determine_execution_priority(risk_metrics),
            asset_allocations=signals.asset_allocations,
            
            # NEW: Cycle tracking fields
            cycle_timestamp=cycle_timestamp,
            total_exposure_pct=exposure_pct,
            diversification_score=diversification_score,
            portfolio_value=portfolio_value,
            cash_allocation_pct=100 - exposure_pct
        )
        
        logger.info(f"Generated portfolio signals for cycle {cycle_timestamp}: "
                   f"{len(signals.buy_signals)} buys, {len(signals.sell_signals)} sells")
        
        return portfolio_signal
        
    except Exception as e:
        logger.error(f"Portfolio signal generation failed: {e}")
        return PortfolioSignal(buy_signals=[], sell_signals=[], portfolio_risk_score=1.0)

async def _calculate_enhanced_risk_metrics(self) -> Dict[str, float]:
    """Calculate enhanced risk metrics for cycle tracking"""
    try:
        # Existing risk calculations...
        concentration_risk = await self._calculate_concentration_risk()
        correlation_risk = await self._calculate_correlation_risk()
        
        # NEW: Additional risk metrics for database tracking
        volatility_risk = await self._calculate_portfolio_volatility()
        drawdown_risk = await self._calculate_max_drawdown()
        
        return {
            'overall_risk': (concentration_risk + correlation_risk + volatility_risk) / 3,
            'concentration_risk': concentration_risk,
            'correlation_risk': correlation_risk,
            'volatility_risk': volatility_risk,
            'drawdown_risk': drawdown_risk
        }
        
    except Exception as e:
        logger.error(f"Risk metrics calculation failed: {e}")
        return {'overall_risk': 1.0}

def _calculate_diversification_score(self, buy_signals: List[TradingSignal]) -> float:
    """Calculate portfolio diversification score (0-1, higher is better)"""
    try:
        if not buy_signals:
            return 1.0
        
        # Simple diversification: inverse of concentration
        total_allocation = sum(s.position_value_usdc for s in buy_signals)
        if total_allocation == 0:
            return 1.0
        
        # Calculate Herfindahl-Hirschman Index
        allocations = [s.position_value_usdc / total_allocation for s in buy_signals]
        hhi = sum(alloc ** 2 for alloc in allocations)
        
        # Convert to diversification score (1 - HHI, bounded)
        diversification = max(0.0, min(1.0, 1.0 - hhi))
        
        return diversification
        
    except Exception as e:
        logger.error(f"Diversification calculation failed: {e}")
        return 0.5

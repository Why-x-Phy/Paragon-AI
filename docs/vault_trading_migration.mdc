## **4. EMERGENCY MONITORING EVENTS TABLE**

**Research Findings**: `EmergencyStopLossMonitor` records events in `system_health` table via `_record_emergency_event()`.

**Data Sources**:
- `EmergencyStopLossMonitor._record_emergency_event()`
- Emergency exit executions

**Required Fields**:
```sql
CREATE TABLE IF NOT EXISTS emergency_events (
    event_id SERIAL PRIMARY KEY,
    event_time TIMESTAMPTZ NOT NULL,             -- Event timestamp
    event_type VARCHAR(20) NOT NULL,             -- 'stop_loss', 'portfolio_limit', 'volatility_spike'
    
    -- Position Details
    token_id INTEGER,                            -- Token involved (nullable for portfolio events)
    position_size DOUBLE PRECISION,              -- Position size at event
    
    -- Trigger Information
    trigger_value DOUBLE PRECISION,              -- Value that triggered event
    threshold_value DOUBLE PRECISION,            -- Threshold that was breached
    trigger_type VARCHAR(20),                    -- 'price', 'pnl_pct', 'volatility'
    
    -- Action Taken
    action_taken VARCHAR(20),                    -- 'exit_position', 'reduce_position', 'pause_trading'
    tx_signature VARCHAR(88),                    -- Transaction if action executed
    
    -- Impact Assessment
    portfolio_impact DOUBLE PRECISION,           -- Impact on portfolio value
    position_pnl DOUBLE PRECISION,               -- P&L at exit
    
    -- Context
    notes TEXT,                                  -- Additional context
    
    -- Metadata
    created_at TIMESTAMPTZ DEFAULT NOW(),
    
    -- Constraints
    CONSTRAINT fk_emergency_token FOREIGN KEY (token_id) REFERENCES tokens(token_id),
    CONSTRAINT check_emergency_event_type CHECK (event_type IN ('stop_loss', 'portfolio_limit', 'volatility_spike', 'manual_exit')),
    CONSTRAINT check_emergency_action CHECK (action_taken IN ('exit_position', 'reduce_position', 'pause_trading', 'alert_only'))
);

-- Create indexes for emergency events
CREATE INDEX IF NOT EXISTS idx_emergency_time 
    ON emergency_events(event_time DESC);

CREATE INDEX IF NOT EXISTS idx_emergency_type 
    ON emergency_events(event_type, event_time DESC);
```

## **5. MATERIALIZED VIEWS FOR MONITORING**

**Research Findings**: The schema needs monitoring-specific materialized views for efficient querying.

**Required Views**:
```sql
-- Real-time trading performance view
CREATE MATERIALIZED VIEW IF NOT EXISTS trading_performance_hourly
WITH (timescaledb.continuous) AS
SELECT 
    time_bucket('1 hour', cycle_timestamp) AS hour,
    COUNT(*) as total_trades,
    COUNT(*) FILTER (WHERE signal_strength = 'STRONG') as strong_signals,
    AVG(signal_confidence) as avg_confidence,
    SUM(value_usdc) as total_volume_usdc,
    AVG(processing_time_ms) as avg_processing_time_ms
FROM trades
GROUP BY hour;

-- Portfolio risk monitoring view  
CREATE MATERIALIZED VIEW IF NOT EXISTS portfolio_risk_hourly
WITH (timescaledb.continuous) AS
SELECT 
    time_bucket('1 hour', cycle_timestamp) AS hour,
    AVG(portfolio_risk_score) as avg_risk_score,
    MAX(portfolio_risk_score) as max_risk_score,
    AVG(total_exposure_pct) as avg_exposure_pct,
    MAX(max_single_position_pct) as max_position_pct
FROM portfolio_cycles
WHERE status = 'completed'
GROUP BY hour;

-- Emergency events summary
CREATE MATERIALIZED VIEW IF NOT EXISTS emergency_events_daily
WITH (timescaledb.continuous) AS
SELECT 
    time_bucket('1 day', event_time) AS day,
    event_type,
    COUNT(*) as event_count,
    AVG(portfolio_impact) as avg_portfolio_impact,
    SUM(portfolio_impact) as total_portfolio_impact
FROM emergency_events
GROUP BY day, event_type;
```


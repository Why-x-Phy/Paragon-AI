# UPDATE: _record_emergency_event method
async def _record_emergency_event(self, event_type: str, symbol: str, details: Dict[str, Any]):
    """Record emergency event with enhanced tracking"""
    try:
        # Get token ID
        token_id = None
        if symbol:
            token_info = await self.db_manager.get_token_by_symbol(symbol)
            token_id = token_info['token_id'] if token_info else None
        
        # Create emergency event data
        event_data = EmergencyEventData(
            event_time=datetime.now(),
            event_type=event_type,
            token_id=token_id,
            position_size=details.get('position_size'),
            trigger_value=details.get('trigger_value'),
            threshold_value=details.get('threshold_value'),
            trigger_type=details.get('trigger_type'),
            action_taken=details.get('action_taken'),
            tx_signature=details.get('tx_signature'),
            portfolio_impact=details.get('portfolio_impact'),
            position_pnl=details.get('position_pnl'),
            notes=details.get('notes')
        )
        
        # Record in database
        event_id = await self.db_manager.record_emergency_event(event_data)
        logger.critical(f"🚨 Recorded emergency event {event_id}: {event_type}")
        
        return event_id
        
    except Exception as e:
        logger.error(f"Failed to record emergency event: {e}")
        return None

# UPDATE: _execute_emergency_exit method
async def _execute_emergency_exit(self, symbol: str, position, reason: str):
    """Execute emergency exit with enhanced tracking"""
    try:
        if self.emergency_exits_today >= self.max_daily_exits:
            await self._record_emergency_event('daily_limit_reached', symbol, {
                'trigger_type': 'daily_limit',
                'action_taken': 'alert_only',
                'notes': f'Daily emergency exit limit reached: {self.emergency_exits_today}'
            })
            return
        
        # Execute emergency sell order via vault
        exit_result = await self.vault_client.emergency_exit_position(symbol, position.size)
        
        if exit_result:
            self.emergency_exits_today += 1
            
            # Record successful emergency exit
            await self._record_emergency_event('emergency_exit_executed', symbol, {
                'position_size': position.size,
                'trigger_type': reason,
                'action_taken': 'exit_position',
                'tx_signature': exit_result,
                'position_pnl': getattr(position, 'unrealized_pnl', None),
                'notes': f'Emergency exit executed due to {reason}'
            })
            
            logger.critical(f"✅ Emergency exit completed: {symbol} - {reason}")
        else:
            # Record failed emergency exit
            await self._record_emergency_event('emergency_exit_failed', symbol, {
                'position_size': position.size,
                'trigger_type': reason,
                'action_taken': 'exit_position',
                'notes': f'Emergency exit failed for {symbol}',
                'error_message': 'Vault client exit failed'
            })
            
    except Exception as e:
        logger.error(f"Emergency exit execution failed: {e}")
        await self._record_emergency_event('emergency_exit_error', symbol, {
            'trigger_type': reason,
            'action_taken': 'exit_position',
            'error_message': str(e),
            'notes': f'Emergency exit error for {symbol}'
        })

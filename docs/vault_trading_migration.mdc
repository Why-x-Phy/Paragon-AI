# UPDATE: create_jupiter_trade method to record Jupiter operations
async def create_jupiter_trade(self, input_mint: str, output_mint: str, 
                             amount_usdc: float, slippage_bps: int = 50) -> Optional[bytes]:
    """Create Jupiter swap transaction data and record the operation"""
    try:
        start_time = time.time()
        
        # Get Jupiter quote
        quote = await self.jupiter_client.get_quote(
            input_mint=input_mint,
            output_mint=output_mint,
            amount=int(amount_usdc * 1e6),
            slippage_bps=slippage_bps
        )
        
        if not quote or 'error' in quote:
            # Record failed operation
            operation_data = JupiterOperationData(
                trade_id=0,  # Will be updated later
                operation_time=datetime.now(),
                operation_type='quote',
                input_mint=input_mint,
                output_mint=output_mint,
                success=False,
                error_message=str(quote.get('error', 'Quote failed'))
            )
            await self._record_jupiter_operation(operation_data)
            return None
        
        # Get swap transaction data
        swap_data = await self.jupiter_client.get_swap_transaction(quote)
        
        execution_time_ms = int((time.time() - start_time) * 1000)
        
        # Record successful operation
        operation_data = JupiterOperationData(
            trade_id=0,  # Will be updated when trade is recorded
            operation_time=datetime.now(),
            operation_type='swap',
            input_mint=input_mint,
            output_mint=output_mint,
            input_amount=int(quote.get('inAmount', 0)),
            output_amount=int(quote.get('outAmount', 0)),
            slippage_bps=slippage_bps,
            price_impact_pct=float(quote.get('priceImpactPct', 0)),
            route_plan=quote.get('routePlan'),
            success=True,
            execution_time_ms=execution_time_ms
        )
        
        jupiter_id = await self._record_jupiter_operation(operation_data)
        
        # Store jupiter_id for trade recording
        self._pending_jupiter_id = jupiter_id
        
        return swap_data
        
    except Exception as e:
        logger.error(f"Jupiter trade creation failed: {e}")
        return None

async def _record_jupiter_operation(self, operation: JupiterOperationData) -> Optional[int]:
    """Record Jupiter operation in database"""
    try:
        if not self.db_manager:
            await self.initialize()
        
        return await self.db_manager.record_jupiter_operation(operation)
    except Exception as e:
        logger.error(f"Failed to record Jupiter operation: {e}")
        return None
```

### **3. Hourly Inference Scheduler Updates (hourly_inference_scheduler.py)**

#### **Portfolio Cycle Management Integration**
```python
# UPDATE: run_inference_and_trading_cycle method
async def run_inference_and_trading_cycle(self):
    """Complete cycle with enhanced portfolio cycle tracking"""
    cycle_start_time = datetime.now().replace(minute=0, second=0, microsecond=0)
    cycle_id = None
    
    try:
        # 1. Create portfolio cycle record
        cycle_data = PortfolioCycleData(
            cycle_timestamp=cycle_start_time,
            status='running'
        )
        
        if not self.db_manager:
            self.db_manager = await get_db_manager()
        
        cycle_id = await self.db_manager.record_portfolio_cycle(cycle_data)
        logger.info(f"🚀 Started portfolio cycle {cycle_id} at {cycle_start_time}")
        
        # 2. Prepare inference data (EXISTING FUNCTIONALITY)
        inference_data = await self.prepare_batch_inference_data()
        ready_tokens = [addr for addr, data in inference_data.items() 
                       if data.get('ready_for_inference', False)]
        
        if len(ready_tokens) < 5:
            await self._complete_cycle_with_error(cycle_id, "Insufficient tokens ready for inference")
            return
        
        # 3. Generate portfolio signals (EXISTING INTEGRATION)
        from ..inference.portfolio_coordinator import generate_portfolio_signals
        portfolio_signals = await generate_portfolio_signals()
        
        if not portfolio_signals:
            await self._complete_cycle_with_status(cycle_id, 'completed', {
                'signals_generated': 0,
                'message': 'No portfolio signals generated'
            })
            return
        
        # 4. Execute vault trades (EXISTING FUNCTIONALITY)
        trades_executed = 0
        if portfolio_signals.buy_signals:
            from ..vault.trade_executor import VaultTradeExecutor
            executor = VaultTradeExecutor()
            
            trade_results = await executor.execute_portfolio_trades(portfolio_signals)
            trades_executed = len([r for r in trade_results if r])
            
            logger.info(f"Executed {trades_executed} vault trades")
        
        # 5. Complete cycle with success metrics
        cycle_duration = (datetime.now() - cycle_start_time).total_seconds()
        
        await self._complete_cycle_with_status(cycle_id, 'completed', {
            'cycle_duration_seconds': cycle_duration,
            'signals_generated': len(portfolio_signals.buy_signals + portfolio_signals.sell_signals),
            'buy_signals': len(portfolio_signals.buy_signals),
            'sell_signals': len(portfolio_signals.sell_signals),
            'trades_executed': trades_executed,
            'portfolio_risk_score': portfolio_signals.portfolio_risk_score,
            'execution_priority': portfolio_signals.execution_priority,
            'total_exposure_pct': getattr(portfolio_signals, 'total_exposure_pct', None),
            'diversification_score': getattr(portfolio_signals, 'diversification_score', None)
        })
        
        logger.info(f"✅ Completed portfolio cycle {cycle_id} in {cycle_duration:.1f}s")
    
    except Exception as e:
        logger.error(f"Inference and trading cycle failed: {e}")
        if cycle_id:
            await self._complete_cycle_with_error(cycle_id, str(e))

async def _complete_cycle_with_status(self, cycle_id: int, status: str, metrics: Dict[str, Any]):
    """Complete cycle with status and metrics"""
    try:
        updates = {
            'status': status,
            **metrics
        }
        await self.db_manager.update_portfolio_cycle(cycle_id, updates)
    except Exception as e:
        logger.error(f"Failed to update cycle {cycle_id}: {e}")

async def _complete_cycle_with_error(self, cycle_id: int, error_message: str):
    """Complete cycle with error status"""
    await self._complete_cycle_with_status(cycle_id, 'failed', {
        'error_message': error_message,
        'cycle_duration_seconds': (datetime.now() - 
            datetime.now().replace(minute=0, second=0, microsecond=0)).total_seconds()
    })
```


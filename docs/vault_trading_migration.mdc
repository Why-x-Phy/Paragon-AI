# UPDATE: get_quote method to support tracking
async def get_quote(self, input_mint: str, output_mint: str, amount: int, 
                   slippage_bps: int = 50, track_operation: bool = True) -> Optional[Dict]:
    """Get Jupiter quote with optional operation tracking"""
    start_time = time.time()
    
    try:
        # Existing quote logic...
        quote = await self._fetch_quote(input_mint, output_mint, amount, slippage_bps)
        
        # NEW: Track operation if requested
        if track_operation and hasattr(self, 'db_manager') and self.db_manager:
            execution_time_ms = int((time.time() - start_time) * 1000)
            
            operation_data = JupiterOperationData(
                trade_id=0,  # Updated later when linked to trade
                operation_time=datetime.now(),
                operation_type='quote',
                input_mint=input_mint,
                output_mint=output_mint,
                input_amount=amount,
                output_amount=int(quote.get('outAmount', 0)) if quote else 0,
                slippage_bps=slippage_bps,
                price_impact_pct=float(quote.get('priceImpactPct', 0)) if quote else None,
                route_plan=quote.get('routePlan') if quote else None,
                success=quote is not None and 'error' not in quote,
                error_message=quote.get('error') if quote and 'error' in quote else None,
                execution_time_ms=execution_time_ms
            )
            
            # Store for later linking to trade
            self._last_operation_data = operation_data
        
        return quote
        
    except Exception as e:
        logger.error(f"Jupiter quote failed: {e}")
        
        # Track failed operation
        if track_operation and hasattr(self, 'db_manager') and self.db_manager:
            operation_data = JupiterOperationData(
                trade_id=0,
                operation_time=datetime.now(),
                operation_type='quote',
                input_mint=input_mint,
                output_mint=output_mint,
                input_amount=amount,
                slippage_bps=slippage_bps,
                success=False,
                error_message=str(e),
                execution_time_ms=int((time.time() - start_time) * 1000)
            )
            self._last_operation_data = operation_data
        
        return None

# NEW: Method to link operations to trades
async def link_last_operation_to_trade(self, trade_id: int) -> Optional[int]:
    """Link the last recorded operation to a trade"""
    try:
        if hasattr(self, '_last_operation_data') and self._last_operation_data:
            # Update trade_id and record in database
            self._last_operation_data.trade_id = trade_id
            
            if hasattr(self, 'db_manager') and self.db_manager:
                jupiter_id = await self.db_manager.record_jupiter_operation(self._last_operation_data)
                self._last_operation_data = None  # Clear after recording
                return jupiter_id
        
        return None
        
    except Exception as e:
        logger.error(f"Failed to link Jupiter operation to trade: {e}")
        return None

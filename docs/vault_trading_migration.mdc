    CONSTRAINT check_jupiter_operation_type CHECK (operation_type IN ('quote', 'swap'))
);

-- Create indexes for Jupiter operations
CREATE INDEX IF NOT EXISTS idx_jupiter_trade 
    ON jupiter_operations(trade_id);

CREATE INDEX IF NOT EXISTS idx_jupiter_time 
    ON jupiter_operations(operation_time DESC);
